# Server
NODE_ENV=development
BACKEND_PORT=4000
BACKEND_URL=https://pdf-rag-chatbot-2-rlae.onrender.com
CORS_ORIGIN=http://localhost:3000,https://MY-ACTUAL-VERCEL-DOMAIN.vercel.app

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/pdf_rag_chatbot?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Default Admin Account (used for seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_admin_password_here
ADMIN_NAME=Super Admin